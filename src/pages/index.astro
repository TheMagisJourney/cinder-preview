---
import Base from '../layouts/Base.astro';
import { DOORS, DOOR_ORDER } from '../data/doors.js';

const doorKey = Astro.url.searchParams.get('d') || 'dating';
const active = DOORS[doorKey] || DOORS.dating;
const doors = DOOR_ORDER.map((k) => DOORS[k]);
const pageTitle = 'Cinder - ' + active.word;
const doorJson = JSON.stringify(DOORS);
const base = import.meta.env.BASE_URL;
---
<Base door={active.id} title={pageTitle} description={active.sub}>
  <section class="studio" id="top" aria-label="Cinder studio">
    <div class="container studio-grid">
      <div class="studio-copy">
        <p class="eyebrow">AI photo studio &middot; founding access</p>
        <h1 id="hero-promise">{active.promise}</h1>
        <p class="studio-sub" id="hero-sub">{active.sub}</p>
        <div class="studio-actions">
          <a class="btn btn-primary" id="hero-cta" href="#founding">{active.cta}</a>
          <a class="btn btn-ghost" href="#founding">See founding terms</a>
        </div>
        <p class="honesty">
          These are sample results made with Cinder - not real customers yet. We will only show permissioned real photos when we have them.
        </p>
        {active.ethics ? (
          <p class="ethics-line" id="ethics-line">
            Cinder enhances light, framing, and presentation. It never invents a different face. You stay you.
          </p>
        ) : (
          <p class="ethics-line" id="ethics-line" style="display:none"></p>
        )}

        <p class="door-label" id="doors-label">I am here for</p>
        <ul class="door-chips" role="list" aria-labelledby="doors-label">
          {doors.map((d) => (
            <li>
              <button
                type="button"
                class="door-chip"
                data-door={d.id}
                aria-pressed={d.id === active.id ? 'true' : 'false'}
              >
                <span class="dot" aria-hidden="true"></span>
                {d.word}
              </button>
            </li>
          ))}
        </ul>
        <noscript>
          <p style="margin-top:0.75rem;font-size:0.85rem;color:var(--bone-dim)">
            <a href={`${base}dating/`}>Dating</a> &middot;
            <a href={`${base}career/`}>Career</a> &middot;
            <a href={`${base}acting/`}>Acting</a> &middot;
            <a href={`${base}portfolio/`}>Portfolio</a>
          </p>
        </noscript>
      </div>

      <div class="studio-stage" id="studio-stage" aria-live="polite">
        <figure class="shot shot-before">
          <img id="hero-before" src={active.before} alt="Sample before photo" width="900" height="1200" />
          <figcaption class="shot-cap">Before</figcaption>
        </figure>
        <figure class="shot shot-after">
          <img id="hero-after" src={active.after} alt="Sample after photo" width="900" height="1200" fetchpriority="high" />
          <figcaption class="shot-cap">After</figcaption>
          <span class="shot-sample">Sample</span>
        </figure>
        <p class="stage-note">Same person. Better light, framing, and presentation.</p>
      </div>
    </div>
  </section>

  <section class="credibility" id="proof" aria-labelledby="proof-title">
    <div class="container">
      <p class="section-kicker">Why the photo matters</p>
      <h2 class="section-title" id="proof-title">First impressions form fast. Quality shows.</h2>
      <div class="stats">
        <article class="stat">
          <div class="stat-value">~100ms</div>
          <div class="stat-label">Time for a first impression of a face to form.</div>
          <div class="stat-source">Willis and Todorov, Princeton - 2006</div>
        </article>
        <article class="stat">
          <div class="stat-value">Higher</div>
          <div class="stat-label">Profiles with strong primary photos earn materially more engagement across dating and professional platforms.</div>
          <div class="stat-source">Industry photo-quality studies - problem-side</div>
        </article>
        <article class="stat">
          <div class="stat-value">You</div>
          <div class="stat-label">Still recognizably you - better light, framing, and presentation. Not a stranger.</div>
          <div class="stat-source">Cinder product promise</div>
        </article>
      </div>
      <div class="proof-strip" aria-label="Sample proof strip">
        <figure class="proof-card">
          <img src={`${base}samples/proof-1-after.jpg`} alt="Sample result one" loading="lazy" width="600" height="800" />
          <span class="chip">Sample</span>
        </figure>
        <figure class="proof-card">
          <img src={`${base}samples/proof-2-after.jpg`} alt="Sample result two" loading="lazy" width="600" height="800" />
          <span class="chip">Sample</span>
        </figure>
        <figure class="proof-card">
          <img src={`${base}samples/proof-3-after.jpg`} alt="Sample result three" loading="lazy" width="600" height="800" />
          <span class="chip">Sample</span>
        </figure>
      </div>
      <p class="proof-note">Illustrative sample results. Real, permissioned customer photos replace these after launch.</p>
    </div>
  </section>

  <section class="founding-shape" id="stories" aria-labelledby="stories-title">
    <div class="container">
      <div class="founding-panel">
        <p class="section-kicker" style="color: var(--bone-dim)">Stories</p>
        <h2 class="section-title" id="stories-title" style="margin-bottom:0">Founding members shape what goes here.</h2>
        <p>
          We are not inventing testimonials. Early members get priority in the first render queue - and the first real stories on this page will be yours, with permission.
        </p>
      </div>
    </div>
  </section>

  <section class="cta" id="founding" aria-labelledby="founding-title">
    <div class="container">
      <p class="section-kicker">Founding access</p>
      <h2 class="section-title" id="founding-title">Get priority. Lock founding price for life.</h2>
      <p class="cta-lead">
        Founding members receive priority in the first render queue and the founding price locked for life.
        Email only - no spam theater, no fake countdown.
      </p>
      <form class="founding-form" id="founding-form" novalidate>
        <input type="hidden" name="door" id="form-door" value={active.id} />
        <div class="form-row">
          <label for="email" style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0)">Email</label>
          <input id="email" name="email" type="email" required autocomplete="email" placeholder="you@email.com" />
          <button class="btn btn-primary" type="submit" id="submit-btn">{active.cta}</button>
        </div>
        <p class="trust">Your photos stay yours. Never sold. Deleted on request.</p>
        <div class="form-success" id="form-success" role="status" aria-live="polite">
          You are on the founding list. We will reach out when your priority window opens.
        </div>
      </form>
    </div>
  </section>

  <script id="door-data" type="application/json" set:html={doorJson}></script>
  <script is:inline>
    (function () {
      var dataEl = document.getElementById('door-data');
      if (!dataEl) return;
      var DOORS = JSON.parse(dataEl.textContent);
      var chips = document.querySelectorAll('.door-chip[data-door]');
      var promiseEl = document.getElementById('hero-promise');
      var subEl = document.getElementById('hero-sub');
      var ctaEl = document.getElementById('hero-cta');
      var beforeEl = document.getElementById('hero-before');
      var afterEl = document.getElementById('hero-after');
      var ethicsEl = document.getElementById('ethics-line');
      var formDoor = document.getElementById('form-door');
      var submitBtn = document.getElementById('submit-btn');
      var shots = document.querySelectorAll('.shot');

      function setDoor(id) {
        var d = DOORS[id] || DOORS.dating;
        document.body.dataset.door = d.id;
        if (promiseEl) promiseEl.textContent = d.promise;
        if (subEl) subEl.textContent = d.sub;
        if (ctaEl) ctaEl.textContent = d.cta;
        if (submitBtn) submitBtn.textContent = d.cta;
        if (formDoor) formDoor.value = d.id;

        shots.forEach(function (s) { s.classList.add('is-swapping'); });
        var imgLoaded = 0;
        function maybeDone() {
          imgLoaded += 1;
          if (imgLoaded >= 2) {
            shots.forEach(function (s) { s.classList.remove('is-swapping'); });
          }
        }
        if (beforeEl) {
          beforeEl.onload = maybeDone;
          beforeEl.src = d.before;
          if (beforeEl.complete) maybeDone();
        }
        if (afterEl) {
          afterEl.onload = maybeDone;
          afterEl.src = d.after;
          if (afterEl.complete) maybeDone();
        }
        setTimeout(function () {
          shots.forEach(function (s) { s.classList.remove('is-swapping'); });
        }, 500);

        if (ethicsEl) {
          if (d.ethics) {
            ethicsEl.style.display = '';
            ethicsEl.textContent = 'Cinder enhances light, framing, and presentation. It never invents a different face. You stay you.';
          } else {
            ethicsEl.style.display = 'none';
          }
        }
        chips.forEach(function (b) {
          b.setAttribute('aria-pressed', b.getAttribute('data-door') === d.id ? 'true' : 'false');
        });
        try {
          var url = new URL(window.location.href);
          url.searchParams.set('d', d.id);
          history.replaceState({}, '', url);
        } catch (e) {}
      }

      chips.forEach(function (btn) {
        btn.addEventListener('click', function () {
          setDoor(btn.getAttribute('data-door'));
        });
      });

      var form = document.getElementById('founding-form');
      var success = document.getElementById('form-success');
      if (form) {
        form.addEventListener('submit', function (e) {
          e.preventDefault();
          var email = document.getElementById('email').value.trim();
          if (!email || email.indexOf('@') < 0) {
            document.getElementById('email').focus();
            return;
          }
          var door = (formDoor && formDoor.value) || 'dating';
          try {
            var list = JSON.parse(localStorage.getItem('cinder_founders') || '[]');
            list.push({ email: email, door: door, at: new Date().toISOString() });
            localStorage.setItem('cinder_founders', JSON.stringify(list));
          } catch (err) {}
          if (success) success.classList.add('show');
          var subject = encodeURIComponent('Cinder founding access');
          var body = encodeURIComponent('Please add me to Cinder founding access.\n\nEmail: ' + email + '\nDoor: ' + door);
          window.location.href = 'mailto:aldrick@laudatedominum.miami?subject=' + subject + '&body=' + body;
        });
      }
    })();
  </script>
</Base>