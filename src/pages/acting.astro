---
import Base from '../layouts/Base.astro';
import { DOORS, DOOR_ORDER } from '../data/doors.js';

const active = DOORS['acting'];
const doors = DOOR_ORDER.map((key) => DOORS[key]);
const pageTitle = 'Cinder - ' + active.word;
const base = import.meta.env.BASE_URL;
---
<Base door={active.id} title={pageTitle} description={active.sub}>
  <section class="studio" id="top" aria-label="Cinder studio">
    <div class="container studio-grid">
      <div class="studio-copy">
        <p class="eyebrow">AI photo studio &middot; founding access</p>
        <h1 id="hero-promise">{active.promise}</h1>
        <p class="studio-sub" id="hero-sub">{active.sub}</p>
        <div class="studio-actions">
          <a class="btn btn-primary" href="#founding">{active.cta}</a>
          <a class="btn btn-ghost" href="#founding">See founding terms</a>
        </div>
        <p class="honesty">
          These are sample results made with Cinder - not real customers yet. We will only show permissioned real photos when we have them.
        </p>
        {active.ethics && (
          <p class="ethics-line">
            Cinder enhances light, framing, and presentation. It never invents a different face. You stay you.
          </p>
        )}
        <p class="door-label">I am here for</p>
        <ul class="door-chips" role="list">
          {doors.map((d) => (
            <li>
              <a
                class="door-chip"
                href={base + d.id + '/'}
                aria-current={d.id === active.id ? 'page' : undefined}
              >
                <span class="dot" aria-hidden="true"></span>
                {d.word}
              </a>
            </li>
          ))}
        </ul>
      </div>
      <div class="studio-stage" id="studio-stage">
        <figure class="shot shot-before">
          <img src={active.before} alt="Sample before photo" width="900" height="1200" />
          <figcaption class="shot-cap">Before</figcaption>
        </figure>
        <figure class="shot shot-after">
          <img src={active.after} alt="Sample after photo" width="900" height="1200" fetchpriority="high" />
          <figcaption class="shot-cap">After</figcaption>
          <span class="shot-sample">Sample</span>
        </figure>
        <p class="stage-note">Same person. Better light, framing, and presentation.</p>
      </div>
    </div>
  </section>

  <section class="credibility" id="proof">
    <div class="container">
      <p class="section-kicker">Why the photo matters</p>
      <h2 class="section-title">First impressions form fast. Quality shows.</h2>
      <div class="stats">
        <article class="stat">
          <div class="stat-value">~100ms</div>
          <div class="stat-label">Time for a first impression of a face to form.</div>
          <div class="stat-source">Willis and Todorov, Princeton - 2006</div>
        </article>
        <article class="stat">
          <div class="stat-value">Higher</div>
          <div class="stat-label">Profiles with strong primary photos earn materially more engagement.</div>
          <div class="stat-source">Industry photo-quality studies - problem-side</div>
        </article>
        <article class="stat">
          <div class="stat-value">You</div>
          <div class="stat-label">Still recognizably you - better light, framing, and presentation.</div>
          <div class="stat-source">Cinder product promise</div>
        </article>
      </div>
      <div class="proof-strip">
        <figure class="proof-card"><img src={base + 'samples/proof-1-after.jpg'} alt="" loading="lazy" width="600" height="800" /><span class="chip">Sample</span></figure>
        <figure class="proof-card"><img src={base + 'samples/proof-2-after.jpg'} alt="" loading="lazy" width="600" height="800" /><span class="chip">Sample</span></figure>
        <figure class="proof-card"><img src={base + 'samples/proof-3-after.jpg'} alt="" loading="lazy" width="600" height="800" /><span class="chip">Sample</span></figure>
      </div>
      <p class="proof-note">Illustrative sample results. Real permissioned photos replace these after launch.</p>
    </div>
  </section>

  <section class="founding-shape" id="stories">
    <div class="container">
      <div class="founding-panel">
        <p class="section-kicker" style="color: var(--bone-dim)">Stories</p>
        <h2 class="section-title" style="margin:0">Founding members shape what goes here.</h2>
        <p>We are not inventing testimonials. Early members get priority in the first render queue - and the first real stories will be yours, with permission.</p>
      </div>
    </div>
  </section>

  <section class="cta" id="founding">
    <div class="container">
      <p class="section-kicker">Founding access</p>
      <h2 class="section-title">Get priority. Lock founding price for life.</h2>
      <p class="cta-lead">Founding members receive priority in the first render queue and the founding price locked for life. Email only.</p>
      <form class="founding-form" id="founding-form">
        <input type="hidden" name="door" id="form-door" value={active.id} />
        <div class="form-row">
          <input id="email" name="email" type="email" required autocomplete="email" placeholder="you@email.com" />
          <button class="btn btn-primary" type="submit">{active.cta}</button>
        </div>
        <p class="trust">Your photos stay yours. Never sold. Deleted on request.</p>
        <div class="form-success" id="form-success" role="status">You are on the founding list. We will reach out when your priority window opens.</div>
      </form>
    </div>
  </section>
  <script is:inline>
    document.getElementById('founding-form')?.addEventListener('submit', function (e) {
      e.preventDefault();
      var email = document.getElementById('email').value.trim();
      if (!email || email.indexOf('@') < 0) { document.getElementById('email').focus(); return; }
      var door = document.getElementById('form-door').value || 'acting';
      try {
        var list = JSON.parse(localStorage.getItem('cinder_founders') || '[]');
        list.push({ email: email, door: door, at: new Date().toISOString() });
        localStorage.setItem('cinder_founders', JSON.stringify(list));
      } catch (err) {}
      document.getElementById('form-success').classList.add('show');
      var subject = encodeURIComponent('Cinder founding access');
      var body = encodeURIComponent('Please add me to Cinder founding access.\n\nEmail: ' + email + '\nDoor: ' + door);
      window.location.href = 'mailto:aldrick@laudatedominum.miami?subject=' + subject + '&body=' + body;
    });
  </script>
</Base>