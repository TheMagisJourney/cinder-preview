---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  door?: string;
}
const {
  title = 'Cinder - Your best real self',
  description = 'Professional-grade photos from real photos of you - for dating, career, acting, and portfolio. Still recognizably you.',
  door = 'dating',
} = Astro.props;
const base = import.meta.env.BASE_URL;
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0B0B0C" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={`${base}samples/dating-after.jpg`} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body data-door={door}>
    <header class="site-header">
      <div class="container inner">
        <a class="logo" href={base}>
          <span class="logo-mark" aria-hidden="true"></span>
          Cinder
        </a>
        <nav class="header-nav" aria-label="Primary" style="display:flex;align-items:center;gap:1rem">
          <a href={`${base}#how`} style="text-decoration:none;font-size:0.86rem;color:var(--muted)">How it works</a>
          <a href={`${base}#voices`} style="text-decoration:none;font-size:0.86rem;color:var(--muted)">Stories</a>
          <a class="header-cta" href={`${base}#founding`}>Claim founding access</a>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container">
        <div class="footer-grid">
          <div class="footer-brand">
            <a class="logo" href={base}>
              <span class="logo-mark" aria-hidden="true"></span>
              Cinder
            </a>
            <p>Professional-grade photos from real photos of you. Still recognizably you.</p>
          </div>
          <div class="footer-col">
            <h4>Explore</h4>
            <a href={`${base}dating/`}>Dating</a>
            <a href={`${base}career/`}>Career</a>
            <a href={`${base}acting/`}>Acting</a>
            <a href={`${base}portfolio/`}>Portfolio</a>
          </div>
          <div class="footer-col">
            <h4>Founding</h4>
            <a href={`${base}#founding`}>Claim access</a>
            <a href={`${base}#how`}>How it works</a>
            <a href={`${base}#compare`}>Why Cinder</a>
          </div>
        </div>
        <div class="footer-bottom">
          <span>&copy; {year} Cinder</span>
          <span>Founding access &middot; Priority queue &middot; Locked founding price</span>
        </div>
      </div>
    </footer>
  </body>
</html>